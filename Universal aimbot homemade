local function getScreenCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function checkTeam(player)
    if TeamCheck and player.Team == Plr.Team then return true end
    return false
end

local function checkWall(targetCharacter)
    local targetHead = targetCharacter:FindFirstChild("Head")
    if not targetHead then return true end

    local origin = Camera.CFrame.Position
    local direction = (targetHead.Position - origin).unit * (targetHead.Position - origin).magnitude
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {Plr.Character, targetCharacter}
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist

    local result = Workspace:Raycast(origin, direction, raycastParams)
    return result and result.Instance ~= nil
end

local function getClosestPart(character)
    local shortestDist = AimFov
    local screenCenter = getScreenCenter()

    local validParts = {}
    for _, partName in ipairs(AimParts) do
        local part = character:FindFirstChild(partName)
        if part then table.insert(validParts, part) end
    end

    if #validParts == 0 then return nil end
    local targetPart = validParts[math.random(1, #validParts)]
    local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
    local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude

    if dist < shortestDist and onScreen then
        return targetPart
    end
    return nil
end

local function getTarget()
    local nearestPlayer = nil
    local closestPart = nil
    local shortestDist = AimFov
    local screenCenter = getScreenCenter()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Plr and player.Character and not checkTeam(player) then
            local hum = player.Character:FindFirstChild("Humanoid")
            if hum and (hum.Health >= MinHealth or not HealthCheck) then
                local part = getClosestPart(player.Character)
                if part then
                    local pos = Camera:WorldToViewportPoint(part.Position)
                    local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                    if dist < shortestDist then
                        if not WallCheck or not checkWall(player.Character) then
                            shortestDist = dist
                            nearestPlayer = player
                            closestPart = part
                        end
                    end
                end
            end
        end
    end
    return nearestPlayer, closestPart
end

local function predict(player, part)
    if player and player.Character and part then
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        if root then
            local camSpaceVel = Camera.CFrame:VectorToObjectSpace(root.Velocity)
            local horizontalVel = Vector3.new(camSpaceVel.X, 0, camSpaceVel.Z)
            local worldOffset = Camera.CFrame:VectorToWorldSpace(horizontalVel) * PredictionStrength
            return part.Position + worldOffset
        end
    end
    return nil
end

local function validateCurrentTarget()
    if not CurrentTarget or not CurrentTarget.Character then return false end
    local char = CurrentTarget.Character
    local hum = char:FindFirstChild("Humanoid")
    
    if not hum or hum.Health <= 0 then return false end
    if HealthCheck and hum.Health < MinHealth then return false end
    
    for _, partName in ipairs(AimParts) do
        local part = char:FindFirstChild(partName)
        if part then return true end
    end
    return false
end

RunService.RenderStepped:Connect(function()
    if AimbotEnabled then
        fovGui.Visible = FovVisibility

        if Aiming and CurrentTarget then
            fovStroke.Color = TargetedFovColor
        else
            fovStroke.Color = FovColor
        end

        if Aiming then
            local screenCenter = getScreenCenter()
            
            if StickyAimEnabled and CurrentTarget then
                if not validateCurrentTarget() then
                    CurrentTarget = nil
                    CurrentTargetPart = nil
                else
                    if not CurrentTargetPart or CurrentTargetPart.Parent ~= CurrentTarget.Character then
                        CurrentTargetPart = nil
                        for _, partName in ipairs(AimParts) do
                            local p = CurrentTarget.Character:FindFirstChild(partName)
                            if p then
                                CurrentTargetPart = p
                                break
                            end
                        end
                    end
                end
            end

            if not StickyAimEnabled or not CurrentTarget then
                CurrentTarget, CurrentTargetPart = getTarget()
            end

            if CurrentTarget and CurrentTargetPart then
                local predPos = predict(CurrentTarget, CurrentTargetPart)
                if predPos then
                    local smoothFactor = math.clamp(Smoothing, 1, 100) / 100
                    if AimingStrategy == "Mouse" and mousemoverel then
                        local viewportPos = Camera:WorldToViewportPoint(predPos)
                        local delta = Vector2.new(viewportPos.X - screenCenter.X, viewportPos.Y - screenCenter.Y)
                        mousemoverel(delta.X * smoothFactor, delta.Y * smoothFactor)
                    else
                        local targetCF = CFrame.new(Camera.CFrame.Position, predPos)
                        Camera.CFrame = Camera.CFrame:Lerp(targetCF, smoothFactor)
                    end
                end
            end
        else
            CurrentTarget = nil
            CurrentTargetPart = nil
        end
    else
        fovGui.Visible = false
    end
end)

