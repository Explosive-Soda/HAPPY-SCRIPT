local function saveConfig()
    local configData = {
        AimbotEnabled = AimbotEnabled,
        FovVisibility = FovVisibility,
        AimingStrategy = AimingStrategy,
        AimFov = AimFov,
        AimParts = AimParts,
        Smoothing = Smoothing,
        PredictionStrength = PredictionStrength,
        WallCheck = WallCheck,
        StickyAimEnabled = StickyAimEnabled,
        TeamCheck = TeamCheck,
        HealthCheck = HealthCheck,
        MinHealth = MinHealth,
        FovColor = {math.floor(FovColor.R * 255), math.floor(FovColor.G * 255), math.floor(FovColor.B * 255)},
        TargetedFovColor = {math.floor(TargetedFovColor.R * 255), math.floor(TargetedFovColor.G * 255), math.floor(TargetedFovColor.B * 255)},
        ESPEnabled = ESPEnabled,
        ESPTeamCheck = ESPTeamCheck,
        ESPFillColor = {math.floor(ESPFillColor.R * 255), math.floor(ESPFillColor.G * 255), math.floor(ESPFillColor.B * 255)},
        ESPRenderDistance = ESPRenderDistance,
        ToggleKey = ToggleKey.Name
    }
    local success, encoded = pcall(function() return HttpService:JSONEncode(configData) end)
    if success and writefile then
        writefile(ConfigFileName, encoded)
    end
end

local function resetConfig()
    if isfile and isfile(ConfigFileName) then
        if delfile then delfile(ConfigFileName) end
    end
end

