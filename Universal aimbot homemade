        if decoded.StickyAimEnabled ~= nil then StickyAimEnabled = decoded.StickyAimEnabled end
        if decoded.TeamCheck ~= nil then TeamCheck = decoded.TeamCheck end
        if decoded.HealthCheck ~= nil then HealthCheck = decoded.HealthCheck end
