        optBtn.TextColor3 = table.find(selected, opt) and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(200, 200, 200)
        optBtn.TextSize = 12
        optBtn.Font = Enum.Font.GothamMedium
        optBtn.Text = opt
        optBtn.Parent = dropdownList
        optionButtons[opt] = optBtn

        optBtn.MouseButton1Click:Connect(function()
            if type(defaultSelected) == "table" then
                local idx = table.find(selected, opt)
                if idx then
                    if #selected > 1 then table.remove(selected, idx) end
                else
                    table.insert(selected, opt)
                end
                for _, o in ipairs(options) do
                    optionButtons[o].TextColor3 = table.find(selected, o) and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(200, 200, 200)
