local function saveConfig()
    local configData = {
        AimbotEnabled = AimbotEnabled,
        AimFov = AimFov,
        WallCheck = WallCheck,
        StickyAimEnabled = StickyAimEnabled,
        TeamCheck = TeamCheck,
        HealthCheck = HealthCheck,
        MinHealth = MinHealth,
        ESPEnabled = ESPEnabled,
        BoxESPEnabled = BoxESPEnabled,
        ESPTeamCheck = ESPTeamCheck,
        ESPRenderDistance = ESPRenderDistance
    }
    local success, encoded = pcall(function() return HttpService:JSONEncode(configData) end)
    if success and writefile then
        writefile(ConfigFileName, encoded)
    end
end

local function resetConfig()
    if isfile and isfile(ConfigFileName) then
        if delfile then delfile(ConfigFileName) end
    end
end

