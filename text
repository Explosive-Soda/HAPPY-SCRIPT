local function cleanupPlayerESP(player)
    if ESPHighlights[player] then
        ESPHighlights[player]:Destroy()
        ESPHighlights[player] = nil
    end
    if BoxESPDrawings[player] then
        for _, line in pairs(BoxESPDrawings[player]) do
            line:Remove()
        end
        BoxESPDrawings[player] = nil
    end
end

Players.PlayerRemoving:Connect(cleanupPlayerESP)

local function getCharacterCoreBounds(char)
    local coreParts = {"Head", "UpperTorso", "LowerTorso", "Torso", "HumanoidRootPart", "Left Leg", "Right Leg", "Left Arm", "Right Arm", "LeftLowerArm", "RightLowerArm", "LeftUpperArm", "RightUpperArm", "LeftLowerLeg", "RightLowerLeg", "LeftUpperLeg", "RightUpperLeg"}
    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
    local valid = false

    for _, name in ipairs(coreParts) do
        local part = char:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            valid = true
            local p = part.Position
            local s = part.Size
            minX = math.min(minX, p.X - s.X/2)
            minY = math.min(minY, p.Y - s.Y/2)
            minZ = math.min(minZ, p.Z - s.Z/2)
            maxX = math.max(maxX, p.X + s.X/2)
            maxY = math.max(maxY, p.Y + s.Y/2)
            maxZ = math.max(maxZ, p.Z + s.Z/2)
        end
    end

    if not valid then return nil, nil end

    local topWorld = Vector3.new((minX + maxX) / 2, maxY + 0.1, (minZ + maxZ) / 2)
    local botWorld = Vector3.new((minX + maxX) / 2, minY - 0.1, (minZ + maxZ) / 2)
    return topWorld, botWorld
end

local function updateESP()
    local myHrp = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
    local inset = GuiService:GetGuiInset() -- Get Topbar / GUI Inset offset (fixes vertical screen projection mismatch)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Plr then
            local char = player.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local alive = hum and hum.Health > 0
            local isEnemy = not ESPTeamCheck or player.Team ~= Plr.Team
            local inDist = true

            if myHrp and hrp then
                inDist = (hrp.Position - myHrp.Position).Magnitude <= ESPRenderDistance
            end

            if char and alive and isEnemy and inDist then
                if not ESPHighlights[player] then
                    local hl = Instance.new("Highlight")
                    hl.Parent = char
                    hl.FillColor = ESPFillColor
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(0, 0, 0)
                    hl.OutlineTransparency = 0
                    hl.Adornee = char
                    hl.Enabled = ESPEnabled
                    ESPHighlights[player] = hl
                else
                    local hl = ESPHighlights[player]
                    hl.FillColor = ESPFillColor
                    hl.Enabled = ESPEnabled
                    if hl.Parent ~= char then hl.Parent = char hl.Adornee = char end
                end

                if BoxESPEnabled and hrp then
                    if not BoxESPDrawings[player] then
                        local box = {
                            Top = Drawing.new("Line"),
                            Bottom = Drawing.new("Line"),
                            Left = Drawing.new("Line"),
                            Right = Drawing.new("Line")
                        }
                        for _, line in pairs(box) do 
                            line.Thickness = BoxESPThickness 
                            line.Color = BoxESPColor 
                        end
                        BoxESPDrawings[player] = box
                    end
                    
                    local box = BoxESPDrawings[player]
                    local topWorld, botWorld = getCharacterCoreBounds(char)
                    
                    if topWorld and botWorld then
                        local topPos, topVis = Camera:WorldToViewportPoint(topWorld)
                        local botPos, botVis = Camera:WorldToViewportPoint(botWorld)
                        
                        if topVis or botVis then
                            local height = math.abs(botPos.Y - topPos.Y)
                            local width = height * 0.6
                            local centerX = (topPos.X + botPos.X) / 2
                            local boxX = centerX - width / 2
                            -- Add inset.Y to correct the Drawing library offset caused by the Roblox Topbar!
                            local boxY = math.min(topPos.Y, botPos.Y) + inset.Y
                            
                            box.Top.From = Vector2.new(boxX, boxY)
                            box.Top.To = Vector2.new(boxX + width, boxY)
                            
                            box.Bottom.From = Vector2.new(boxX, boxY + height)
                            box.Bottom.To = Vector2.new(boxX + width, boxY + height)
                            
                            box.Left.From = Vector2.new(boxX, boxY)
                            box.Left.To = Vector2.new(boxX, boxY + height)
                            
                            box.Right.From = Vector2.new(boxX + width, boxY)
                            box.Right.To = Vector2.new(boxX + width, boxY + height)

                            for _, line in pairs(box) do line.Visible = true end
                        else
                            for _, line in pairs(box) do line.Visible = false end
                        end
                    else
                        for _, line in pairs(box) do line.Visible = false end
                    end
                else
                    if BoxESPDrawings[player] then
                        for _, line in pairs(BoxESPDrawings[player]) do line.Visible = false end
                    end
                end
            else
                if ESPHighlights[player] then ESPHighlights[player].Enabled = false end
                if BoxESPDrawings[player] then
                    for _, line in pairs(BoxESPDrawings[player]) do line.Visible = false end
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if ESPEnabled or BoxESPEnabled then
        updateESP()
    else
        for _, hl in pairs(ESPHighlights) do hl.Enabled = false end
        for _, box in pairs(BoxESPDrawings) do
            for _, line in pairs(box) do line.Visible = false end
        end
    end
end)

