-- [[ Core Logic: Aimbot ]] --
local fovCircle = Drawing.new("Circle")
fovCircle.Thickness = 2
fovCircle.Radius = AimFov
fovCircle.NumSides = 64
fovCircle.Filled = false
fovCircle.Color = FovColor
fovCircle.Visible = false

local function checkTeam(player)
    if TeamCheck and player.Team == Plr.Team then return true end
    return false
end

local function checkWall(targetCharacter)
    local targetHead = targetCharacter:FindFirstChild("Head")
    if not targetHead then return true end

    local origin = Camera.CFrame.Position
    local direction = (targetHead.Position - origin).unit * (targetHead.Position - origin).magnitude
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {Plr.Character, targetCharacter}
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist

    local result = Workspace:Raycast(origin, direction, raycastParams)
    return result and result.Instance ~= nil
end

local function getClosestPart(character)
    local closestPart = nil
    local shortestDist = AimFov
    local mouseLoc = UserInputService:GetMouseLocation()

    local validParts = {}
    for _, partName in ipairs(AimParts) do
        local part = character:FindFirstChild(partName)
        if part then table.insert(validParts, part) end
    end

    if #validParts == 0 then return nil end
    local targetPart = validParts[math.random(1, #validParts)]
    local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
    local dist = (Vector2.new(pos.X, pos.Y) - mouseLoc).Magnitude

    if dist < shortestDist and onScreen then
        return targetPart
    end
    return nil
end

local function getTarget()
    local nearestPlayer = nil
    local closestPart = nil
    local shortestDist = AimFov
    local mouseLoc = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Plr and player.Character and not checkTeam(player) then
            local hum = player.Character:FindFirstChild("Humanoid")
            if hum and (hum.Health >= MinHealth or not HealthCheck) then
                local part = getClosestPart(player.Character)
                if part then
                    local pos = Camera:WorldToViewportPoint(part.Position)
                    local dist = (Vector2.new(pos.X, pos.Y) - mouseLoc).Magnitude
                    if dist < shortestDist then
                        if not WallCheck or not checkWall(player.Character) then
                            shortestDist = dist
                            nearestPlayer = player
                            closestPart = part
                        end
                    end
                end
            end
        end
    end
    return nearestPlayer, closestPart
end

local function predict(player, part)
    if player and player.Character and part then
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        if root then
            return part.Position + (root.Velocity * PredictionStrength)
        end
    end
    return nil
end

RunService.RenderStepped:Connect(function()
    if AimbotEnabled then
        local mouseLoc = UserInputService:GetMouseLocation()
        fovCircle.Position = mouseLoc -- GetMouseLocation matches Drawing window coordinates perfectly
        fovCircle.Visible = FovVisibility

        if Aiming and CurrentTarget then
            fovCircle.Color = TargetedFovColor
        else
            fovCircle.Color = FovColor
        end

        if Aiming then
            if StickyAimEnabled and CurrentTarget then
                if not CurrentTarget.Character or not CurrentTarget.Character:FindFirstChild("Head") then
                    CurrentTarget = nil
                    CurrentTargetPart = nil
                end
            end

            if not StickyAimEnabled or not CurrentTarget then
                CurrentTarget, CurrentTargetPart = getTarget()
            end

            if CurrentTarget and CurrentTargetPart then
                local predPos = predict(CurrentTarget, CurrentTargetPart)
                if predPos then
                    local smoothFactor = math.clamp(Smoothing, 1, 100) / 100
                    if AimingStrategy == "Mouse" and mousemoverel then
                        local viewportPos = Camera:WorldToViewportPoint(predPos)
                        local delta = Vector2.new(viewportPos.X - mouseLoc.X, viewportPos.Y - mouseLoc.Y)
                        mousemoverel(delta.X * smoothFactor, delta.Y * smoothFactor)
                    else
                        local targetCF = CFrame.new(Camera.CFrame.Position, predPos)
                        Camera.CFrame = Camera.CFrame:Lerp(targetCF, smoothFactor)
                    end
                end
            end
        else
            CurrentTarget = nil
            CurrentTargetPart = nil
        end
    else
        fovCircle.Visible = false
    end
end)

Mouse.Button2Down:Connect(function() if AimbotEnabled then Aiming = true end end)
